# Copier en .env.local (jamais commité) pour le dev local.
# Laisser vide : les appels /api/... passent par le proxy Vite vers
# http://localhost:3000 (voir vite.config.js).
VITE_API_URL=

# En prod (Vercel), renseigner l'URL Railway/Render du backend, par ex :
# VITE_API_URL=https://rsi-code-qr-api.up.railway.app

# URL publique du site (canonical/OG de index.html, robots.txt, sitemap.xml).
# Facultatif : par défaut https://rsicodeqrapp.vercel.app (voir vite.config.js).
# VITE_SITE_URL=https://rsicodeqrapp.vercel.app
