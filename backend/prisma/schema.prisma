// ==============================
// RsiCodeQrApp — Schéma Prisma
// Paquet "backend" — modèle de données convenu avec l'équipe
// ==============================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Requêtes de l'app : transaction pooler Supabase (port 6543, pgbouncer=true,
  // connection_limit=1) — indispensable en serverless (Vercel), le session
  // pooler (5432) plafonne à 15 clients et se sature.
  url       = env("DATABASE_URL")
  // Migrations (prisma migrate) : connexion en mode session (port 5432),
  // le transaction pooler ne supporte pas les verrous de migration.
  directUrl = env("DIRECT_URL")
}

// Type de pointage : pour l'instant UNE seule action de badgeage est supportée.
// L'enum existe déjà pour ne pas casser le schéma quand la gestion
// entrée/sortie sera ajoutée. Champ inutilisé par la logique actuelle.
enum TypePointage {
  ENTRER
  SORTIR
}

// Rôle d'un admin. Hiérarchie :
//   SUPER_ADMIN : gestion des admins (register) + tout le reste
//   ADMIN       : gestion complète des ouvriers/pointages (pas les admins)
//   LECTEUR     : lecture seule du dashboard
enum RoleAdmin {
  SUPER_ADMIN
  ADMIN
  LECTEUR
}

// Poste d'un ouvrier dans un département donné.
// RESPONSABLE et ADJOINT sont uniques par département (vérif côté back).
enum RoleDepartement {
  RESPONSABLE
  ADJOINT
  SECRETAIRE
  MEMBRE
}

// Temple (église locale). SHALOM est le siège. Identifiants fixes posés par la
// migration 20261104120000_temples ("eglise-shalom", "eglise-adjahui",
// "eglise-quatre-croix") : le siège sert de valeur par défaut aux colonnes
// egliseId, ce qui garde valides les écritures qui ne précisent pas de temple.
model Eglise {
  id        String   @id @default(uuid())
  code      String   @unique // SHALOM | ADJAHUI | QUATRE_CROIX (URL du terminal, import)
  nom       String   @unique // « Temple SHALOM »
  estSiege  Boolean  @default(false)
  actif     Boolean  @default(true)
  // Ligne « district » imprimée sur la carte de badge (« DISTRICT-SIÈGE »).
  libelleCarte String?
  createdAt DateTime @default(now())

  departements Departement[]
  ouvriers     Ouvrier[]
  pointages    Pointage[] // pointages FAITS dans ce temple (lieu du terminal)

  @@map("Eglise")
}

// Un département appartient à UN temple : « CHORALE » peut exister dans
// chaque temple (unicité du nom par temple).
model Departement {
  id          String  @id @default(uuid())
  nom         String
  description String?
  // Couleur de la carte de badge (#RRGGBB), fixée par un admin. Vide = carte non imprimable.
  couleur     String?
  egliseId    String  @default("eglise-shalom")
  createdAt   DateTime @default(now())

  eglise  Eglise @relation(fields: [egliseId], references: [id])
  membres OuvrierDepartement[]
  badges  BadgeConfectionne[]

  @@unique([egliseId, nom])
  @@index([egliseId])
  @@map("Departement")
}

// Table de jonction Ouvrier ↔ Département (many-to-many) avec poste.
model OuvrierDepartement {
  id                String          @id @default(uuid())
  ouvrierId         String
  departementId     String
  roleDansDepartement RoleDepartement @default(MEMBRE)
  // Fonction imprimée sur la carte (« RESPONSABLE ADJOINTE ») ; vide = déduite du rôle.
  fonctionCarte     String?
  createdAt         DateTime        @default(now())

  ouvrier     Ouvrier     @relation(fields: [ouvrierId], references: [id], onDelete: Cascade)
  departement Departement @relation(fields: [departementId], references: [id], onDelete: Cascade)

  @@unique([ouvrierId, departementId])
  @@index([departementId])
  @@map("OuvrierDepartement")
}

model Ouvrier {
  id          String  @id @default(uuid())
  matricule   String  @unique // encodé dans le QR code
  nom         String
  prenom      String
  photoUrl    String? // optionnel
  telephone   String? // optionnel (contact de l'ouvrier)
  actif       Boolean @default(true) // badge valide tant qu'actif = true
  // Temple d'appartenance : l'ouvrier ne rejoint que des départements de ce temple.
  egliseId    String  @default("eglise-shalom")
  createdAt   DateTime @default(now())

  eglise       Eglise @relation(fields: [egliseId], references: [id])
  pointages    Pointage[]
  departements OuvrierDepartement[]
  photo        PhotoOuvrier?
  badges       BadgeConfectionne[]

  @@index([egliseId])
  @@map("Ouvrier")
}

model Pointage {
  id        String   @id @default(uuid())
  ouvrierId String
  ouvrier   Ouvrier  @relation(fields: [ouvrierId], references: [id], onDelete: Cascade)
  dateHeure DateTime @default(now())
  // Jour civil (UTC, AAAA-MM-JJ) : garantit en base qu'un ouvrier ne peut
  // badger qu'UNE fois par jour, même si deux requêtes arrivent en parallèle.
  jour      DateTime @db.Date
  type      TypePointage @default(ENTRER) // non utilisé pour l'instant
  // Lieu du badgeage : temple du terminal (peut différer du temple de
  // l'ouvrier → « visiteur »). Null seulement si le temple a été supprimé.
  egliseId  String?
  eglise    Eglise?  @relation(fields: [egliseId], references: [id], onDelete: SetNull)

  @@unique([ouvrierId, jour])
  @@index([ouvrierId, dateHeure])
  @@index([jour])
  @@index([egliseId, jour])
  @@map("Pointage")
}

model Admin {
  id         String    @id @default(uuid())
  email      String    @unique
  nom        String? // nom de famille (facultatif, affiché dans le dashboard)
  prenom     String? // prénom (facultatif, affiché dans le dashboard)
  motDePasse String // haché avec bcrypt
  role       RoleAdmin @default(ADMIN) // hiérarchie SUPER_ADMIN > ADMIN > LECTEUR
  actif      Boolean   @default(true) // compte activable/désactivable par le SUPER_ADMIN
  // Blocage anti brute-force : après 3 échecs, le compte est gelé 15 min
  // (bloqueJusqua). Un SUPER_ADMIN peut débloquer manuellement.
  tentativesEchouees Int       @default(0)
  bloqueJusqua       DateTime?
  // Lien de réinitialisation de mot de passe (stocké HASHÉ, expirant).
  resetTokenHash   String?   @unique
  resetTokenExpire DateTime?
  createdAt        DateTime  @default(now())

  @@map("Admin")
}
// Photo d'identité de la carte de badge (JPEG/PNG/WebP compressé côté navigateur).
model PhotoOuvrier {
  ouvrierId String   @id
  type      String // image/jpeg | image/png | image/webp
  donnees   Bytes
  updatedAt DateTime @updatedAt

  ouvrier Ouvrier @relation(fields: [ouvrierId], references: [id], onDelete: Cascade)

  @@map("PhotoOuvrier")
}

// Carte de badge confectionnée (imprimée ou téléchargée) pour un ouvrier et un département.
model BadgeConfectionne {
  id            String   @id @default(uuid())
  ouvrierId     String
  departementId String
  adminEmail    String?
  createdAt     DateTime @default(now())

  ouvrier     Ouvrier     @relation(fields: [ouvrierId], references: [id], onDelete: Cascade)
  departement Departement @relation(fields: [departementId], references: [id], onDelete: Cascade)

  @@index([ouvrierId])
  @@index([departementId])
  @@map("BadgeConfectionne")
}
