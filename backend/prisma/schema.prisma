// ==============================
// RsiCodeQrApp — Schéma Prisma
// Paquet "backend" — modèle de données convenu avec l'équipe
// ==============================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Type de pointage : pour l'instant UNE seule action de badgeage est supportée.
// L'enum existe déjà pour ne pas casser le schéma quand la gestion
// entrée/sortie sera ajoutée. Champ inutilisé par la logique actuelle.
enum TypePointage {
  ENTRER
  SORTIR
}

// Rôle d'un admin. Hiérarchie :
//   SUPER_ADMIN : gestion des admins (register) + tout le reste
//   ADMIN       : gestion complète des ouvriers/pointages (pas les admins)
//   LECTEUR     : lecture seule du dashboard
enum RoleAdmin {
  SUPER_ADMIN
  ADMIN
  LECTEUR
}

// Poste d'un ouvrier dans un département donné.
// RESPONSABLE et ADJOINT sont uniques par département (vérif côté back).
enum RoleDepartement {
  RESPONSABLE
  ADJOINT
  SECRETAIRE
  MEMBRE
}

model Departement {
  id          String  @id @default(uuid())
  nom         String  @unique
  description String?
  createdAt   DateTime @default(now())

  membres OuvrierDepartement[]

  @@map("Departement")
}

// Table de jonction Ouvrier ↔ Département (many-to-many) avec poste.
model OuvrierDepartement {
  id                String          @id @default(uuid())
  ouvrierId         String
  departementId     String
  roleDansDepartement RoleDepartement @default(MEMBRE)
  createdAt         DateTime        @default(now())

  ouvrier     Ouvrier     @relation(fields: [ouvrierId], references: [id], onDelete: Cascade)
  departement Departement @relation(fields: [departementId], references: [id], onDelete: Cascade)

  @@unique([ouvrierId, departementId])
  @@index([departementId])
  @@map("OuvrierDepartement")
}

model Ouvrier {
  id          String  @id @default(uuid())
  matricule   String  @unique // encodé dans le QR code
  nom         String
  prenom      String
  photoUrl    String? // optionnel
  actif       Boolean @default(true) // badge valide tant qu'actif = true
  createdAt   DateTime @default(now())

  pointages   Pointage[]
  departements OuvrierDepartement[]

  @@map("Ouvrier")
}

model Pointage {
  id        String   @id @default(uuid())
  ouvrierId String
  ouvrier   Ouvrier  @relation(fields: [ouvrierId], references: [id], onDelete: Cascade)
  dateHeure DateTime @default(now())
  type      TypePointage @default(ENTRER) // non utilisé pour l'instant

  @@index([ouvrierId, dateHeure])
  @@map("Pointage")
}

model Admin {
  id         String    @id @default(uuid())
  email      String    @unique
  motDePasse String // haché avec bcrypt (étape 7)
  role       RoleAdmin @default(ADMIN) // hiérarchie SUPER_ADMIN > ADMIN > LECTEUR
  createdAt  DateTime  @default(now())

  @@map("Admin")
}