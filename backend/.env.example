# == Configuration locale (dev) ==
# Copier ce fichier en `.env` et adapter les valeurs.
# NE JAMAIS committer le `.env` en production.

# Base de données locale PostgreSQL (exemple pour Windows)
DATABASE_URL="postgresql://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/rsi_code_qr_dev?schema=public"

# Miroir des engines Prisma (utile quand binaries.prisma.sh est inaccessible)
# PRISMA_ENGINES_MIRROR=https://registry.npmmirror.com/-/binary/prisma

# Port du serveur API
PORT=3000

# Mot de passe admin par défaut (à hacher en base) — étape 7
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-moi

# Secret JWT pour l'auth (étape 7) — générer avec: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-moi-aussi

# URL publique du backend (pour construire les URL des photos/badges dans l'API)
PUBLIC_BASE_URL=http://localhost:3000