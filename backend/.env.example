# == Configuration locale (dev) ==
# Copier ce fichier en `.env` et adapter les valeurs.
# NE JAMAIS committer le `.env` en production.

# Base de données PostgreSQL.
# >> BASE COMMUNE Supabase (= base de PRODUCTION) : Dashboard Supabase →
#    Connect → copier les URI du pooler (host "aws-1-<REGION>.pooler.supabase.com").
#    Format : postgres.<REF-PROJET>:<MOT-DE-PASSE>@… (l'identifiant du projet
#    vient AVANT les « : », le mot de passe APRÈS).
#    - DATABASE_URL = Transaction pooler (port 6543, pgbouncer=true,
#      connection_limit=1) : requêtes de l'app. OBLIGATOIRE sur Vercel (le
#      session pooler 5432 plafonne à 15 clients → EMAXCONNSESSION).
#    - DIRECT_URL = Session pooler (port 5432) : utilisé seulement par
#      `prisma migrate`.
#    - Le mot de passe reste PRIVÉ : le partager hors du dépôt (jamais commiter).
#    - Les tests (npm test) ne tournent JAMAIS sur cette base : voir .env.test
#      dans le README (section Tests).
# >> LOCALE (Windows, dev solo) : même URL dans les deux variables, par ex.
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rsi_code_qr_dev?schema=public"
DATABASE_URL="postgresql://postgres.<REF-PROJET>:<MOT-DE-PASSE>@aws-1-<REGION>.pooler.supabase.com:6543/postgres?schema=public&pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://postgres.<REF-PROJET>:<MOT-DE-PASSE>@aws-1-<REGION>.pooler.supabase.com:5432/postgres?schema=public&sslmode=require"

# Miroir des engines Prisma (utile quand binaries.prisma.sh est inaccessible)
PRISMA_ENGINES_MIRROR=https://registry.npmmirror.com/-/binary/prisma

# Port du serveur API
PORT=3000

# Mot de passe admin par défaut (à hacher en base) — étape 7
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-moi

# Secret JWT pour l'auth (étape 7) — générer avec: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=79R0RNUhN_P_4_9222u-YSRFjJp9e-iZa9WZMWS38An5Pef6iJnarZEF4ABNhIUY

# URL publique du backend (pour construire les URL des photos/badges dans l'API)
PUBLIC_BASE_URL=http://localhost:3000

# URL publique du dashboard (pour les liens de réinitialisation de mot de passe
# envoyés par email). Doit pointer vers le front en production.
APP_URL=http://localhost:5174

# Destinataires par défaut des rapports envoyés par email (séparés par des virgules)
# Liste définie pour l'envoi automatique à J+1 et l'envoi manuel.
RAPPORT_EMAIL_DESTINATAIRES=menzancharle@gmail.com,broujeanmarie697@gmail.com

# Secret qui protège la route cron Vercel /api/cron/rapports (envoi auto J+1).
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#CRON_SECRET=changer-moi

# Origines autorisées pour le CORS du dashboard (séparées par des virgules).
# Par défaut : les dev servers Vite (5173/5174). En production, mettre le/les
# domaine(s) du dashboard. Le terminal (servi par le backend) n'en a pas besoin.
#CORS_ORIGINES=http://localhost:5173,http://localhost:5174

# == Envoi des rapports de pointage par email (SMTP) ==
# Requis pour la route POST /api/rapports/journalier et le job quotidien 06h00.
# Exemple avec Gmail (activer "Application passwords") :
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=moncompte@gmail.com
# SMTP_PASS=monmotdepassedapplication
# SMTP_EXPEDITEUR="Rapports <moncompte@gmail.com>"   # 'From' affiché (défaut : SMTP_USER)

# == Logs (débogage) ==
# Niveau de détail : error | warn | info | debug (défaut: info)
LOG_LEVEL=info
# Écriture d'un fichier backend/logs/app-<jour>.log (rotation quotidienne).
# Par défaut : activé hors production (log_file=true), désactivé sur Vercel.
# En prod Vercel, les logs restent visibles dans le dashboard Functions → Logs.
#LOG_FILE=true