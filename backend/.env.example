# == Configuration locale (dev) ==
# Copier ce fichier en `.env` et adapter les valeurs.
# NE JAMAIS committer le `.env` en production.

# Base de données PostgreSQL.
# >> BASE COMMUNE (toute l'équipe, pour uniformiser les tests) — Supabase :
#    Dashboard Supabase → Connect → "Session pooler" → copier l'URI (host
#    "aws-1-<REGION>.pooler.supabase.com", port 5432). Remplacer [YOUR-PASSWORD].
#    - Session pooler = IPv4, accessible partout. Éviter "Direct connection"
#      (IPv6 uniquement). Ajouter "&connection_limit=4" pour rester sous la
#      limite gratuite de connexions quand toute l'équipe est connectée.
#    - Le mot de passe reste PRIVÉ : le partager hors du dépôt (jamais commiter).
# >> LOCALE (Windows, dev solo) :
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rsi_code_qr_dev?schema=public"
DATABASE_URL="postgresql://postgres.<REF-PROJET>:<MOT-DE-PASSE>@aws-1-<REGION>.pooler.supabase.com:5432/postgres?schema=public&connection_limit=4&sslmode=require"

# Miroir des engines Prisma (utile quand binaries.prisma.sh est inaccessible)
PRISMA_ENGINES_MIRROR=https://registry.npmmirror.com/-/binary/prisma

# Port du serveur API
PORT=3000

# Mot de passe admin par défaut (à hacher en base) — étape 7
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-moi

# Secret JWT pour l'auth (étape 7) — générer avec: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=79R0RNUhN_P_4_9222u-YSRFjJp9e-iZa9WZMWS38An5Pef6iJnarZEF4ABNhIUY

# URL publique du backend (pour construire les URL des photos/badges dans l'API)
PUBLIC_BASE_URL=http://localhost:3000

# Destinataires par défaut des rapports envoyés par email (séparés par des virgules)
# Exemple : RAPPORT_EMAIL_DESTINATAIRES=responsable@eglise.ci,secretariat@eglise.ci
#RAPPORT_EMAIL_DESTINATAIRES=responsable@eglise.ci,secretariat@eglise.ci

# Origines autorisées pour le CORS du dashboard (séparées par des virgules).
# Par défaut : les dev servers Vite (5173/5174). En production, mettre le/les
# domaine(s) du dashboard. Le terminal (servi par le backend) n'en a pas besoin.
#CORS_ORIGINES=http://localhost:5173,http://localhost:5174

# == Envoi des rapports de pointage par email (SMTP) ==
# Requis pour la route POST /api/rapports/journalier et le job quotidien 06h00.
# Exemple avec Gmail (activer "Application passwords") :
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=moncompte@gmail.com
# SMTP_PASS=monmotdepassedapplication
# SMTP_EXPEDITEUR="Rapports <moncompte@gmail.com>"   # 'From' affiché (défaut : SMTP_USER)